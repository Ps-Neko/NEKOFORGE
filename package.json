{
  "name": "nekoforge",
  "version": "0.5.0-alpha.6",
  "description": "NEKOFORGE — source-aware local AI development harness: turns existing codebases into reusable context and task packets, and gates AI changes behind a tamper-evident verdict before explicit apply.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "keywords": [
    "ai",
    "harness",
    "codegen",
    "code-review",
    "claude",
    "codex",
    "cursor",
    "developer-tools",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ps-Neko/NEKOFORGE.git"
  },
  "homepage": "https://github.com/Ps-Neko/NEKOFORGE#readme",
  "bugs": {
    "url": "https://github.com/Ps-Neko/NEKOFORGE/issues"
  },
  "bin": {
    "nekoforge": "dist/src/cli/index.js",
    "harness": "dist/src/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "start": "node dist/src/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "depcheck": "depcruise --config depcruise.config.cjs src",
    "deadexports": "node scripts/deadexports.mjs",
    "benchmark": "tsx src/cli/index.ts benchmark",
    "verify": "npm run typecheck && npm run lint && npm run depcheck && npm run deadexports && npm test",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^9.17.0",
    "knip": "^6.16.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.3"
  },
  "engines": {
    "node": ">=20"
  }
}
